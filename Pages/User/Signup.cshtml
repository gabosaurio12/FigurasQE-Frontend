@page
@model SignupModel
@{
    ViewData["Title"] = "Signup";
    Layout = "_LayoutNoHeader";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const range = document.getElementById('age');
            const output = document.getElementById('ageLabel');

            const updateAge = () => {
                output.textContent = range.value + " años";
            };

            updateAge();
            range.addEventListener('input', updateAge);

            const neuroContainer = document.getElementById('neuroContainer');
            const gradeContainer = document.getElementById('degreeContainer');

            const roleRadios = document.querySelectorAll('input[name="Input.Role"]');

            const toggleRoleFields = () => {
                const selected = document.querySelector('input[name="Input.Role"]:checked')?.value;

                if (selected === "tutor") {
                    neuroContainer?.classList.add('d-none');
                    gradeContainer?.classList.remove('d-none');
                    range.value = 18;
                    output.textContent = range.value + " años";
                } else {
                    neuroContainer?.classList.remove('d-none');
                    gradeContainer?.classList.add('d-none');
                    range.value = 5;
                    output.textContent = range.value + " años";
                }
            };

            roleRadios.forEach(r => r.addEventListener('change', toggleRoleFields));
            toggleRoleFields();
        });
    </script>
}

<div class="container py-5">

    <form method="post" class="bg-white p-4 p-md-5 rounded-4 shadow mx-auto" style="max-width: 720px;">

        <!-- HEADER -->
        <div class="text-center mb-4">
            <h1 class="fw-bold">Crear cuenta</h1>
            <p class="text-muted">Completa tu información para comenzar</p>
        </div>

        <!-- ROLE + AGE -->
        <div class="row g-4 mb-4">

            <div class="col-md-6">
                <div class="p-3 border rounded-3 h-100">
                    <label class="form-label fw-semibold">Tipo de usuario</label>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Input.Role" value="student"
                               id="student" />
                        <label class="form-check-label" for="student">Estudiante</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Input.Role" value="tutor" id="tutor" />
                        <label class="form-check-label" for="tutor">Tutor</label>
                    </div>

                    <span asp-validation-for="Input.Role" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-3 border rounded-3 h-100">
                    <label class="form-label fw-semibold">
                        Edad: <span id="ageLabel">@Model.Input.Age</span>
                    </label>

                    <input type="range" class="form-range" min="1" max="85" step="1" asp-for="Input.Age" id="age" />

                    <span asp-validation-for="Input.Age" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- NAME + EMAIL -->
        <div class="row g-3 mb-3">

            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="Input.Name" class="form-control" placeholder="" />
                    <label asp-for="Input.Name">Nombre</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="Input.Email" type="email" class="form-control" placeholder="" />
                    <label asp-for=" Input.Email">Correo</label>
                </div>
            </div>

        </div>

        <!-- COUNTRY + GENRE -->
        <div class="row g-3 mb-3">

            <div class="col-md-6">
                <label class="form-label">País</label>
                <select asp-for="Input.Country" class="form-select" asp-items="Model.Countries">
                    <option value="">Selecciona un país</option>
                </select>
                <span asp-validation-for="Input.Country" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Género</label>
                <select asp-for="Input.Genre" class="form-select">
                    <option value="">Selecciona</option>
                    <option value="M">Masculino</option>
                    <option value="F">Femenino</option>
                    <option value="O">Otro</option>
                </select>
                <span asp-validation-for="Input.Genre" class="text-danger small"></span>
            </div>

        </div>

        <!-- NEURO + DEGREE -->
        <div class="row g-3 mb-4">

            <div class="col-md-6" id="neuroContainer">
                <label class="form-label">Neurodivergencia</label>
                <select asp-for="Input.Neurodivergency" class="form-select" asp-items="Model.Neurodivergencies">
                    <option value="">Selecciona</option>
                </select>
                <span asp-validation-for="Input.Neurodivergency" class="text-danger small"></span>
            </div>

            <div class="col-md-6 d-none" id="degreeContainer">
                <label class="form-label">Grado académico</label>
                <select asp-for="Input.Degree" class="form-select">
                    <option value="">Selecciona un grado</option>
                    <option value="licenciatura">Licenciatura</option>
                    <option value="maestria">Maestría</option>
                    <option value="doctorado">Doctorado</option>
                    <option value="postdoctorado">Post Doctorado</option>
                    <option value="padre-madre">Padre o Madre</option>
                </select>
                <span asp-validation-for="Input.Degree" class="text-danger small"></span>
            </div>

        </div>

        <!-- PASSWORD -->
        <div class="form-floating mb-4">
            <input asp-for="Input.Password" type="password" class="form-control" placeholder="" />
            <label asp-for="Input.Password">Contraseña</label>
        </div>

        <!-- BUTTON -->
        <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
            Crear cuenta
        </button>

        <div class="text-center">
            <a asp-page="/User/Login" class="text-decoration-none">
                ¿Ya tienes cuenta? Inicia sesión
            </a>
        </div>

    </form>
</div>