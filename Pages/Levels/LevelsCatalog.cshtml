@page
@model LevelsCatalogModel
@{
    ViewData["Title"] = "Niveles";
    Layout = "_LayoutNoHeader";
}

<div class="text-center mb-4">
    <a asp-page="/Index" class="link-dark display-4 link-offset-2 link-underline link-underline-opacity-0" ">Figuras Que Enseñan</a>
</div>

@if (!string.IsNullOrEmpty(Model.WarningMessage))
{
    <div class="alert alert-warning">
        @Model.WarningMessage
    </div>
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="grid-container mb-4">
    <a asp-page="/Levels/Level1/Level1" class="cell btn btn-dark" action="POST ">
        Nivel 1
    </a>
    <a asp-page="/Levels/Level2/Level2" class="cell btn btn-primary">
        Nivel 2
    </a>
    <a asp-page="/Levels/Level3/Level3" class="cell btn btn-success">
        Nivel 3
    </a>
    <a asp-page="/Levels/Level4/Level4" class="cell btn btn-light">
        Nivel 4
    </a>
    <a asp-page="/Levels/Level5/Level5" class="cell btn btn-warning">
        Nivel 5
    </a>
    <a asp-page="/Levels/Level6/Level6" class="cell btn btn-danger">
        Nivel 6
    </a>
</div>

<form method="post" asp-page-handler="EndSession">
    <button type="submit" class="btn btn-danger">
        Terminar sesión
    </button>
</form>

<!-- SUCCESS MODAL -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">¡Éxito!</h5>
                <a asp-page="/Student/Home" class="btn-close btn-close-white"></a>
            </div>

            <div class="modal-body">
                <p id="successMessage"></p>
            </div>

        </div>
    </div>
</div>

<style>
    body {
        background-image: url('/img/BackgroundStatistics.png');
        background-size: cover;
        background-position: center;
        margin-bottom: 60px;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .cell {
        width: 100px;
        height: 100px;

        display: flex;
        justify-content: center;
        align-items: center;

        border-radius: 1rem;
        font-size: 1.2rem;

        transition: all 0.2s ease;
    }
</style>

@section Scripts {
    @using System.Text.Json;
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const successMessage = @Html.Raw(JsonSerializer.Serialize(Model.SuccessMessage));
            if (successMessage && successMessage.trim() !== "") {
                document.getElementById("successMessage").textContent = successMessage;
                new bootstrap.Modal(document.getElementById("successModal")).show();
            }

        });
    </script>
}