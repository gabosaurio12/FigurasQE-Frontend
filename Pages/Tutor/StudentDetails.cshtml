@page "{id:int}"
@model StudentDetailsModel
@{
    ViewData["Title"] = "Detalles de Estudiante";
    Layout = "_LayoutNoHeader";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>

        <a asp-page="/Tutor/SessionsDetails"
           asp-route-id="@Model.Student?.IdStudent"
           class="btn btn-primary btn-lg">
            Ver Sesiones
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card shadow p-4" style="border-radius: 1rem;">

            <h3 class="mb-4">@Model.Student?.Name</h3>

            <div class="row g-4">

                <div class="card-body shadow col-md-4">
                    <label class="text-muted">Edad</label>
                    <div class="fs-5">@Model.Student?.Age años</div>
                </div>

                <div class="card-body shadow col-md-4">
                    <label class="text-muted">País</label>
                    <div class="fs-5">@Model.Student?.Country</div>
                </div>

                <div class="card-body shadow col-md-4">
                    <label class="text-muted">Género</label>
                    <div class="fs-5">@Model.Student?.Gender</div>
                </div>

                <div class="card-body shadow col-md-6">
                    <label class="text-muted">Neurodivergencia</label>
                    <div class="fs-5">
                        @(Model.Student?.Neurodivergency ?? "No especificada")
                    </div>
                </div>

                <div class="card-body shadow col-md-6">
                    <label class="text-muted">Correo</label>
                    <div class="fs-5">@Model.Student?.Email</div>
                </div>

            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card shadow p-4" style="border-radius: 1rem;">

            <h4 class="mb-4">Tutor</h4>

            <div class="row">

                <div class="card-body shadow col-md-6">
                    <label class="text-muted">Nombre</label>
                    <div class="fs-5">
                        @User.Identity?.Name
                    </div>
                </div>

                <div class="card-body shadow col-md-6">
                    <label class="text-muted">Email</label>
                    <div class="fs-5">
                        @User.Identity?.Name
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<a asp-page="/Tutor/Students"
    class="btn btn-secondary">
    Volver
</a>

<style>
    body {
        background-image: url('/img/BackgroundStatistics.png');
        background-size: cover;
        background-position: center;
        margin-bottom: 60px;
    }
</style>